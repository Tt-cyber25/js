PORT=3000
# Đường dẫn file SQLite (":memory:" cho test)
DB_PATH=./data/exchange.db
# BẮT BUỘC đổi trong production — chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BANK_WEBHOOK_SECRET=change-me-shared-secret-with-bank
# Tài khoản phong tỏa (Escrow) tại ngân hàng đối tác — dùng để sinh mã VietQR
ESCROW_BANK_ID=970422
ESCROW_ACCOUNT_NO=0000000000
ESCROW_ACCOUNT_NAME=CONG TY SPV DEMO
# Phí & thuế (basis points: 100 = 1%)
PLATFORM_FEE_BPS=500
OTC_FEE_BPS=50
DIVIDEND_TAX_BPS=500
# Thời gian giữ chỗ đơn mua chưa thanh toán (phút)
ORDER_TTL_MINUTES=30
# "production" sẽ tắt API mô phỏng ngân hàng
NODE_ENV=development
